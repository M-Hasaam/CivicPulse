# ==============================================================================
# CivicPulse environment template (committed). Copy to .env and fill in values.
# New variables are added here by the feature that starts using them.
# ==============================================================================

# Application environment (development / production / test)
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL 16 (async driver). Host "localhost" is for running the backend on
# your machine against a local container; Docker Compose overrides the host.
DATABASE_URL=postgresql+asyncpg://civicpulse:change_me@localhost:5432/civicpulse

# Groq (free tier, https://console.groq.com). Leave empty to always use the rules fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
