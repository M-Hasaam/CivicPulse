# ==============================================================================
# CivicPulse environment template (committed). Copy to .env and fill in values.
# New variables are added here by the feature that starts using them.
# ==============================================================================

# Application environment (development / production / test)
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL 16 credentials. Docker Compose creates the database with these and
# builds the backend's connection URL from them. Change the password.
# Keep it free of URL-reserved characters (@ : / # % ? &): Compose interpolates
# it into a connection string as plain text, with no encoding, so one of those
# breaks the URL for both migrate and backend even though Postgres itself
# accepted the password fine. Letters, digits and - _ . are all safe.
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=change_me
POSTGRES_DB=civicpulse

# Only for running the backend directly on your machine (not in Compose) against
# the local dev container; Compose sets its own URL with host "postgres".
DATABASE_URL=postgresql+asyncpg://civicpulse:change_me@localhost:5432/civicpulse

# Triage provider: auto | llm (Groq) | ollama (offline) | rules | simulated (CI, deterministic)
# "auto" detects what's actually usable at startup - Groq if GROQ_API_KEY validates,
# then Ollama if it's reachable, then rules - so you don't need to pick one by hand
# for the common case. Set llm/ollama explicitly to pin a single provider (still
# falls back to rules on failure); rules/simulated skip AI entirely.
# This is for compose.yaml (dev) and local runs only. compose.prod.yaml reads
# PROD_TRIAGE_PROVIDER instead (defaults to "llm"), precisely so this dev value
# can never silently shadow production's default if this file is reused there.
TRIAGE_PROVIDER=auto

# Groq (free tier, https://console.groq.com). Required when TRIAGE_PROVIDER=llm.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Ollama, the fully offline provider. Compose overrides the host.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Redis 7: stats cache, triage cache and rate limiter. Compose overrides the host.
REDIS_URL=redis://localhost:6379/0

# Rate limit on POST /api/complaints: at most N requests per client per window
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Reverse proxies in front of the backend that append to X-Forwarded-For.
# 1 = nginx only; 2 = ingress + nginx; 0 = no proxy, ignore the header.
# Compose and Kubernetes set this to 1 themselves (compose.yaml, compose.prod.yaml,
# k8s/base/kustomization.yaml) regardless of this file. 0 is the correct value here:
# it's what applies when running the backend directly (README's "manual setup"),
# where there is no proxy and trusting a client-supplied header would let anyone
# fake a new rate-limit identity on every request.
TRUSTED_PROXY_HOPS=0
