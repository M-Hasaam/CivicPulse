# ==============================================================================
# CivicPulse Environment Configuration Template (Commit this to Git)
# Copy this file to .env before starting the project: cp .env.example .env
# ==============================================================================

# Application Environment (development / production / test)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
IMAGE_TAG=dev

# ------------------------------------------------------------------------------
# PostgreSQL 16 Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=civicpulse_secret_change_me
POSTGRES_DB=civicpulse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://civicpulse:civicpulse_secret_change_me@postgres:5432/civicpulse

# ------------------------------------------------------------------------------
# Redis 7 (Cache & Rate Limiter)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# AI Triage Provider Configuration
# Choose one of: llm | simulated | rules | ollama
# ------------------------------------------------------------------------------
TRIAGE_PROVIDER=simulated

# Groq Cloud API (Recommended Free Provider - get key at https://console.groq.com)
GROQ_API_KEY=gsk_placeholder_replace_with_actual_key
GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini API (Alternative Free Provider - get key at https://aistudio.google.com)
GEMINI_API_KEY=placeholder_gemini_api_key

# Ollama Local Offline LLM (Optional)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# ------------------------------------------------------------------------------
# Rate Limiting & Frontend
# ------------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=15
VITE_API_BASE_URL=/api
