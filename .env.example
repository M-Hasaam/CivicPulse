# ==============================================================================
# CivicPulse environment template (committed). Copy to .env and fill in values.
# New variables are added here by the feature that starts using them.
# ==============================================================================

# Application environment (development / production / test)
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL 16 (async driver). Host "localhost" is for running the backend on
# your machine against a local container; Docker Compose overrides the host.
DATABASE_URL=postgresql+asyncpg://civicpulse:change_me@localhost:5432/civicpulse

# Redis 7: stats cache, triage cache and rate limiter. Compose overrides the host.
REDIS_URL=redis://localhost:6379/0

# Rate limit on POST /api/complaints: at most N requests per client per window
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Reverse proxies in front of the backend that append to X-Forwarded-For.
# 1 = nginx only; 2 = ingress + nginx; 0 = no proxy, ignore the header.
TRUSTED_PROXY_HOPS=1
