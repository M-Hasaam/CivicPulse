# Copy this file to secrets.env (gitignored) and set a real, unique password before
# applying this overlay to any real cluster. cd.yml and validate-manifests.yml generate
# a random secrets.env at build time for the ephemeral kind cluster used in CI, so it
# never depends on this file being present.
POSTGRES_PASSWORD=change_me_before_deploying_to_a_real_cluster
GRAFANA_ADMIN_PASSWORD=change_me_before_deploying_to_a_real_cluster
